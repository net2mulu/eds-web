# # =============================================================================
# # Ethiopian Diaspora Service - Environment Variables (Template)
# # =============================================================================
# # Copy this file to .env and .env.local, then fill in your real values.
# #   cp .env.example .env
# #   cp .env.example .env.local
# # =============================================================================

# # MySQL connection string
# # Use "localhost" since MySQL runs on the same server as the website
# # Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL="mysql://user:password@localhost:3306/eds_news"

# # Admin dashboard login credentials
# # ADMIN_PASSWORD must be a bcrypt hash of your password.
# # Generate one: node -e "require('bcryptjs').hash('your-password',12).then(console.log)"
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# # JWT secret for admin session tokens
# # Generate one: openssl rand -base64 32
# JWT_SECRET=change-this-to-a-random-secret

# # Cloudinary image upload configuration
# # Get your credentials at https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
