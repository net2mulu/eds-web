# =============================================================================
# Ethiopian Diaspora Service - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your real values.
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env or .env.local to Git. They contain secrets.
# =============================================================================

# MongoDB connection string (Atlas or self-hosted)
DATABASE_URL=""

# Admin login email
ADMIN_EMAIL=admin@example.com

# JWT secret for admin session tokens
# Generate one: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret

# Cloudinary image upload configuration
# Get your credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
