generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}
model news {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String?
  image       String
  date        String
  category    String
  featured    Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @updatedAt @db.Timestamp(0)
}

model events {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        String
  time        String
  location    String
  image       String
  category    String
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @updatedAt @db.Timestamp(0)
}